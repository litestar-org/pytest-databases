    "tests/test_gizmosql.py::test_plugin_imports_without_adbc_driver_flightsql",
    "tests/test_localstack.py::test_plugin_imports_without_aws_clients",
    "tests/test_mongodb.py::test_plugin_imports_without_pymongo",
    "tests/test_mssql.py::test_plugin_imports_without_pymssql",
    "tests/test_oracle.py::test_plugin_imports_without_oracledb",
    "tests/test_postgres.py::test_plugin_imports_without_psycopg",
    "tests/test_pubsub.py::test_plugin_imports_without_google_cloud_pubsub",
    "tests/test_rabbitmq.py::test_plugin_imports_without_amqp_clients",
    "tests/test_redis.py::test_plugin_imports_without_redis",
