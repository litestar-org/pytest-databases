{
  "schema_version": 1,
  "supported_python_versions": ["3.11", "3.12", "3.13", "3.14", "3.15"],
  "shared_all_provider_paths": [
    "src/pytest_databases/__init__.py",
    "src/pytest_databases/_service.py",
    "src/pytest_databases/docker/__init__.py",
    "src/pytest_databases/helpers.py",
    "src/pytest_databases/runtime.py",
    "src/pytest_databases/types.py",
    "tests/conftest.py"
  ],
  "provider_scoped_dependency_paths": ["pyproject.toml", "uv.lock"],
  "docs_only_globs": [
    "*.md",
    "*.rst",
    "docs/**",
    "scripts/build_docs.py",
    "scripts/convert_docs.sh"
  ],
  "metadata_only_globs": [
    ".editorconfig",
    ".git-blame-ignore-revs",
    ".github/CODEOWNERS",
    ".github/dependabot.yaml",
    ".github/release.yml",
    ".github/workflows/cd.yaml",
    ".github/workflows/docs.yml",
    ".github/workflows/pr-title.yaml",
    ".github/workflows/release.yaml",
    ".gitignore",
    ".pre-commit-config.yaml",
    ".sourcery.yaml",
    ".vscode/**",
    "CODEOWNERS",
    "LICENSE",
    "Makefile",
    "scripts/__init__.py",
    "scripts/install-hatch.sh",
    "sonar-project.properties",
    "src/pytest_databases/__metadata__.py",
    "src/pytest_databases/py.typed",
    "tests/__init__.py",
    "tests/test_ci_*.py",
    "tools/scripts/**"
  ],
  "compatibility_test_paths": [
    "tests/test_azure_blob.py::test_plugin_imports_without_azure_storage_blob",
    "tests/test_bigquery.py::test_plugin_imports_without_google_cloud_bigquery",
    "tests/test_cockroachdb.py::test_plugin_imports_without_psycopg",
